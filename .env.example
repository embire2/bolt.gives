# Core application
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096
BOLT_APP_PUBLIC_URL=https://bolt.example.com
BOLT_ADMIN_PANEL_PUBLIC_URL=https://admin.bolt.example.com
BOLT_CREATE_TRIAL_PUBLIC_URL=https://create.bolt.example.com

# Runtime control and hosted workspaces
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4321
RUNTIME_WORKSPACE_DIR=/srv/bolt-gives-runtime-workspaces
BOLT_RUNTIME_CONTROL_URL=http://127.0.0.1:4321/runtime
BOLT_RUNTIME_CONTROL_PUBLIC_URL=https://bolt.example.com/runtime

# Generate independent high-entropy values during installation.
BOLT_TENANT_ADMIN_COOKIE_SECRET=
BOLT_PROFILE_COOKIE_SECRET=
BOLT_HOSTED_FREE_RELAY_SECRET=
BOLT_FREE_USAGE_QUOTA_SECRET=
BOLT_PREMIUM_INTERNAL_SECRET=

# Optional PostgreSQL-backed bolt.gives profiles and operator data. The app can
# run without these values; generated projects never inherit this database.
BOLT_ADMIN_DATABASE_HOST=127.0.0.1
BOLT_ADMIN_DATABASE_PORT=5432
BOLT_ADMIN_DATABASE_NAME=bolt_gives
BOLT_ADMIN_DATABASE_USER=bolt_gives
BOLT_ADMIN_DATABASE_PASSWORD=
BOLT_ADMIN_DATABASE_SSL=disable

# Generated projects start without a database. User-owned Supabase/PostgreSQL
# connections are stored outside source and injected only into that project.
BOLT_PROJECT_CONNECTION_SECRET_ROOT=/srv/bolt-gives-runtime-workspaces/project-connections
BOLT_PROJECT_CONNECTION_TIMEOUT_MS=10000

# Legacy/operator opt-in only: provision one local database per project. Fresh
# installs leave this disabled; prefer the in-product Database connection flow.
BOLT_PROJECT_DATABASE_ENABLED=false
BOLT_PROJECT_DATABASE_ADMIN_URL=
BOLT_PROJECT_DATABASE_HOST=127.0.0.1
BOLT_PROJECT_DATABASE_PORT=5432
BOLT_PROJECT_DATABASE_SSL=disable
BOLT_PROJECT_DATABASE_SECRET_ROOT=/srv/bolt-gives-runtime-workspaces/project-databases
BOLT_PROJECT_DATABASE_CONNECTION_LIMIT=10

# Optional dedicated Ubuntu CLI node. Workspace creation is database-free by
# default; set the database flag only to preserve legacy automatic local PG.
BOLT_RUNTIME_NODE_ENABLED=false
BOLT_RUNTIME_NODE_DATABASE_ENABLED=false
BOLT_RUNTIME_NODE_HOST=
BOLT_RUNTIME_NODE_PUBLIC_HOST=
BOLT_RUNTIME_NODE_PORT=22
BOLT_RUNTIME_NODE_ADMIN_USER=bolt-runtime-agent
BOLT_RUNTIME_NODE_SSH_KEY_PATH=
BOLT_RUNTIME_NODE_BASE_DIR=/srv/bolt-live-workspaces

# Hosted model allowances. The FREE allowance is time-calibrated so 100 Agent
# tokens cover at least 30 minutes of active generation per GMT+2 day.
BOLT_FREE_DAILY_TOKEN_LIMIT=100
BOLT_CUSTOM_DOMAIN_TOKEN_ALLOWANCE=10000

# Custom Domain account billing. Checkout is created server-side and access is
# activated/reset only by signed Stripe webhooks. Keep secret values server-side.
BOLT_STRIPE_PUBLISHABLE_KEY=
BOLT_STRIPE_SECRET_KEY=
BOLT_STRIPE_WEBHOOK_SECRET=
BOLT_STRIPE_CUSTOM_DOMAIN_PRICE_USD=5

# Optional SMTP for passwordless profile login links and operator mail
BOLT_ADMIN_SMTP_HOST=
BOLT_ADMIN_SMTP_PORT=587
BOLT_ADMIN_SMTP_SECURE=false
BOLT_ADMIN_SMTP_USER=
BOLT_ADMIN_SMTP_PASSWORD=
BOLT_ADMIN_SMTP_FROM=

# Optional Cloudflare deployment control
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BOLT_CLOUDFLARE_PROJECT_DOMAIN_ROOT=instances.bolt.example.com
