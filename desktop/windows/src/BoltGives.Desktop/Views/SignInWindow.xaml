<Window x:Class="BoltGives.Desktop.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to bolt.gives Desktop" Height="650" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource MistBrush}" FontFamily="Segoe UI Variable Text">
  <Grid Margin="34">
    <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource ForestBrush}"
            BorderThickness="1" CornerRadius="26" Padding="30">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="BOLT.GIVES / WINDOWS" Foreground="#5D7A6E" FontSize="12" FontWeight="Bold" />
          <TextBlock Text="Build locally. Run remotely." FontFamily="Georgia" FontSize="31"
                     Foreground="{StaticResource InkBrush}" Margin="0,8,0,6" />
          <TextBlock Text="This is the native Windows client. Your generated app is the only web content shown, inside Preview."
                     TextWrapping="Wrap" Foreground="#52645E" LineHeight="21" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,24,0,16" Background="Transparent" BorderThickness="0">
          <TabItem Header="SIGN IN">
            <StackPanel Margin="2,22,2,0">
              <TextBlock Text="Email address" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBox x:Name="EmailTextBox" Height="42" />
              <Button x:Name="SendCodeButton" Content="Email my code" Margin="0,14,0,0"
                      HorizontalAlignment="Left" Click="SendCode_Click" />
              <Border x:Name="CodePanel" Visibility="Collapsed" Background="#F3F8EB" CornerRadius="14"
                      BorderBrush="#91AA57" BorderThickness="1" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="Enter the six-digit code" FontWeight="Bold" />
                  <TextBlock Text="The code expires after ten minutes and works once." Foreground="#52645E" Margin="0,4,0,10" />
                  <TextBox x:Name="CodeTextBox" MaxLength="6" FontFamily="Consolas" FontSize="24"
                           CharacterCasing="Upper" HorizontalContentAlignment="Center" />
                  <Button Content="Sign in" Margin="0,12,0,0" HorizontalAlignment="Left" Click="VerifyCode_Click" />
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>
          <TabItem Header="CREATE PROFILE">
            <StackPanel Margin="2,22,2,0">
              <TextBlock Text="Name and surname" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBox x:Name="NameTextBox" Height="40" />
              <TextBlock Text="Email address" FontWeight="SemiBold" Margin="0,12,0,6" />
              <TextBox x:Name="RegisterEmailTextBox" Height="40" />
              <TextBlock Text="Country" FontWeight="SemiBold" Margin="0,12,0,6" />
              <TextBox x:Name="CountryTextBox" Height="40" />
              <Button Content="Create my profile" Margin="0,14,0,0" HorizontalAlignment="Left"
                      Click="Register_Click" />
            </StackPanel>
          </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Your session is encrypted for this Windows account."
                   TextWrapping="Wrap" Foreground="#52645E" />
      </Grid>
    </Border>
  </Grid>
</Window>
