<Window x:Class="BoltGives.Desktop.Views.MandatoryUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Required bolt.gives Desktop update" Width="610" Height="570" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" Background="{StaticResource MistBrush}"
        FontFamily="Segoe UI Variable Text" Closing="Window_Closing">
  <Border Margin="24" Padding="26" CornerRadius="22" Background="{StaticResource PaperBrush}"
          BorderBrush="{StaticResource ForestBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="REQUIRED SECURITY AND PRODUCT UPDATE" FontSize="11" FontWeight="Bold" Foreground="#5D7A6E" />
        <TextBlock x:Name="TitleText" FontFamily="Georgia" FontSize="30" Margin="0,7,0,0" />
      </StackPanel>
      <TextBlock Grid.Row="1" Margin="0,12,0,14" TextWrapping="Wrap" Foreground="#52645E"
                 Text="Coding is paused until this update is installed. Windows will request administrator approval. The old app closes before files are replaced, and rollback restores the last verified version if installation fails." />
      <Border Grid.Row="2" Background="#EFF5EA" CornerRadius="14" Padding="16" BorderBrush="#C3D59B" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="FeaturesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,9" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Row="3" Margin="0,16,0,0">
        <TextBlock x:Name="StatusText" Text="Ready to download and verify the signed update." TextWrapping="Wrap" />
        <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Margin="0,9,0,0" />
      </StackPanel>
      <DockPanel Grid.Row="4" Margin="0,18,0,0">
        <Button Content="Exit Desktop" DockPanel.Dock="Left" Background="#F1F3F0" Click="Exit_Click" />
        <Button x:Name="InstallButton" Content="Update now" DockPanel.Dock="Right" Click="Install_Click" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
