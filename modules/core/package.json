{
  "name": "@bolt/core",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "pnpm": "9.14.4",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "lint": "eslint --cache --cache-location .cache/eslint src",
    "test": "vitest --run --root ../.. modules/core/src",
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
  }
}
