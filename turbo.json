{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/**", "dist/**"]
    },
    "lint": {
      "outputs": [".cache/eslint/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [".cache/vitest/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    }
  }
}
