{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true
  },
  "include": [
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "functions/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "build-utils/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "modules/surfaces/mobile/**/*",
    "node_modules/**/*",
    "build/**/*",
    "dist/**/*",
    "output/**/*",
    "test-results/**/*"
  ]
}
